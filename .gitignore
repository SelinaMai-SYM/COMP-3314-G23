!benchmarks/*/data/.gitignore
*.zip
# Strict-repro embedding arrays are large; keep configs/metrics/status only.
runs/strict_repro/**/*.npy
runs/strict_paper/**/*.npy
runs/final_round/**/*.npy
runs/extension_research/**/*.npy
runs/extension_research/**/*.npz
