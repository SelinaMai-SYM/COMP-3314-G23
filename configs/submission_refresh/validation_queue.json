{
  "version": 1,
  "purpose": "Prepublication validation via the same shared ledger and at most two single-thread workers; no validation job bypasses reservation.",
  "frozen_before_execution": true,
  "outputs": "External artifact-root/validation; rebuild outputs never overwrite committed results.",
  "tasks": [
    {
      "run_id": "validation-focused-tests-v1",
      "kind": "validation",
      "phase": "validation",
      "cpu_limit": 900,
      "wall_limit": 1800,
      "command": [
        "{python}",
        "-m",
        "pytest",
        "-q",
        "tests/submission_refresh",
        "tests/next_round",
        "tests/v3/test_lda_math.py",
        "tests/v3/test_llc_procrustes.py",
        "tests/v3/test_ssc_solver.py",
        "tests/v3/test_metrics.py",
        "tests/v3/test_no_label_leakage.py",
        "tests/v3/test_dataset_integrity.py",
        "tests/test_dataset_dispatch.py",
        "baselines/lda_kmeans/test_lda_kmeans.py",
        "baselines/llc/test_llc.py",
        "baselines/spls/test_spls.py"
      ]
    },
    {
      "run_id": "validation-synthetic-cli-v1",
      "kind": "validation",
      "phase": "validation",
      "cpu_limit": 900,
      "wall_limit": 1800,
      "command": [
        "{python}",
        "-m",
        "experiments.v3_reproduction",
        "smoke",
        "--dataset",
        "synthetic"
      ]
    },
    {
      "run_id": "validation-historical-rebuild-v1",
      "kind": "validation",
      "phase": "validation",
      "cpu_limit": 900,
      "wall_limit": 1800,
      "command": [
        "{python}",
        "-m",
        "experiments.v3_reproduction",
        "rebuild-results",
        "--release-manifest",
        "configs/final/release_manifest.json",
        "--output",
        "{validation_dir}/historical_rebuilt"
      ]
    },
    {
      "run_id": "validation-source-audit-v1",
      "kind": "validation",
      "phase": "validation",
      "cpu_limit": 900,
      "wall_limit": 1800,
      "command": [
        "{python}",
        "-m",
        "experiments.submission_refresh.source_audit",
        "--data-root",
        "{data_root}",
        "--output",
        "{validation_dir}/source_audit"
      ]
    }
  ]
}
