% Frozen edge-deletion evidence and three independent quadratic refinements.
\definecolor{embeddingblue}{RGB}{38,88,137}
\definecolor{fusionorange}{RGB}{167,83,17}
\definecolor{outputgreen}{RGB}{56,104,82}
\begin{tikzpicture}[x=1cm,y=1cm,font=\fontsize{9}{10.5}\selectfont,
 box/.style={draw=black!50,rounded corners=2pt,line width=.65pt,align=center,inner sep=4pt,minimum height=.65cm},
 blue/.style={box,draw=embeddingblue,fill=embeddingblue!5},
 orange/.style={box,draw=fusionorange,fill=fusionorange!7},
 green/.style={box,draw=outputgreen,fill=outputgreen!5},
 arrow/.style={-{Latex[length=1.9mm]},line width=.7pt},
 tag/.style={fill=white,inner sep=2pt,font=\fontsize{8}{9}\selectfont,align=center}]
\node[box,text width=1.35cm] (x) at (.65,0) {$X$\\Features};
\node[blue,text width=1.65cm] (a) at (2.9,0) {$A_0$\\Input graph};
\node[blue,text width=1.75cm] (f) at (5.45,0) {$F_0$\\Spectral\\coordinates};
\node[blue,text width=1.9cm] (h) at (8.45,0) {$H$\\Fixed anchor};
\node[orange,text width=2.3cm] (w) at (11.8,0) {$W_0$\\Fusion graph from $H$};
\draw[arrow] (x)--(a);
\draw[arrow,draw=embeddingblue] (a)--(f);
\draw[arrow,draw=embeddingblue] (f)--node[tag,above] {Prep.}(h);
\draw[arrow,draw=fusionorange] (h)--node[tag,above] {Build}(w);
\node[orange,text width=6cm,minimum height=.85cm] (pilot) at (7,-1.7)
 {Frozen ridge pilot on $H,W_0$\\Exact edge-deletion scores $s_e$};
\draw[arrow,draw=embeddingblue] (h.south)--(8.45,-.8)--(5,-.8)--([xshift=-2cm]pilot.north);
\draw[arrow,draw=fusionorange] (w.south)--(11.8,-.8)--(9,-.8)--([xshift=2cm]pilot.north);
\draw[line width=.7pt] (pilot.south)--(7,-2.65);
\draw[line width=.7pt] (2.4,-2.65)--(11.6,-2.65);
\node[tag] at (9,-2.4) {Shared $H,W_0,s$};
\node[orange,text width=3.15cm,minimum height=1.05cm] (e7) at (2.4,-3.55)
 {\textbf{E7}\\Graph weights\\$W_0\to W'$};
\node[orange,text width=3.15cm,minimum height=1.05cm] (e1) at (7,-3.55)
 {\textbf{E1\_v3}\\Edge tolerances\\$a_e$};
\node[orange,text width=3.15cm,minimum height=1.05cm] (e5) at (11.6,-3.55)
 {\textbf{E5\_v2}\\Triangle-slack guards\\$\alpha_e$};
\foreach \v/\xx in {e7/2.4,e1/7,e5/11.6}{
 \draw[arrow] (\xx,-2.65)--(\v.north);
 \draw[draw=outputgreen,line width=.7pt] (\v.south)--(\xx,-4.65);
}
\draw[draw=outputgreen,line width=.7pt] (2.4,-4.65)--(11.6,-4.65);
\node[tag] at (4.7,-4.45) {One objective per run};
\node[green,text width=4.3cm,minimum height=.8cm] (g) at (7,-5.5)
 {$G$ ($Q=G$)\\Refined coordinates};
\draw[arrow,draw=outputgreen] (7,-4.65)--(g.north);
\node[green,text width=3.45cm,minimum height=.8cm] (km) at (11.6,-5.5)
 {K-means $\to$ labels\\Native / anchor starts};
\draw[arrow,draw=outputgreen] (g)--(km);
\node[tag,text width=3.8cm] at (2.4,-5.5) {Controls: SC($H$), QSSC};
\end{tikzpicture}
