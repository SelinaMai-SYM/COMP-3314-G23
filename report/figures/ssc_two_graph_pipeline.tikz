% Authoritative drawing; all exports use this source at its natural size.
\definecolor{embeddingblue}{RGB}{38,88,137}
\definecolor{fusionorange}{RGB}{167,83,17}
\definecolor{outputgreen}{RGB}{56,104,82}
\begin{tikzpicture}[x=1cm,y=1cm,
  font=\fontsize{9}{10.5}\selectfont,
  box/.style={draw=black!55,rounded corners=2pt,line width=.65pt,
    align=center,inner sep=4pt,minimum height=.75cm},
  blue/.style={box,draw=embeddingblue,fill=embeddingblue!5},
  orange/.style={box,draw=fusionorange,fill=fusionorange!7},
  green/.style={box,draw=outputgreen,fill=outputgreen!5},
  arrow/.style={-{Latex[length=2mm]},line width=.7pt},
  tag/.style={fill=white,inner sep=2pt,align=center,font=\fontsize{8}{9}\selectfont}]
\node[box,text width=1.55cm] (x) at (.95,0) {$X$\\Input features};
\node[blue,text width=2.05cm] (a) at (3.4,0) {$A$\\Input-space\\affinity graph};
\node[blue,text width=3.5cm] (lap) at (7.1,0) {Normalized graph Laplacian\\$L_A=I-D_A^{-1/2}AD_A^{-1/2}$};
\node[blue,text width=2.2cm] (f) at (11.2,0) {$F$\\Spectral representation};
\draw[arrow] (x) -- (a);
\draw[arrow,draw=embeddingblue] (a) -- (lap);
\draw[arrow,draw=embeddingblue] (lap) -- node[tag,above=19pt,text width=2cm] {Eigenvectors:\\$c$ smallest\\eigenvalues} (f);
\node[orange,text width=2.4cm] (w) at (2.2,-2.05) {$W$\\Spectral-space\\shrinkage graph};
\node[box,text width=3.65cm,minimum height=1.05cm] (refine) at (7.1,-2.05) {\textbf{SSC refinement}\\Optimize $G$;\\keep $F$ and $W$ fixed.};
\draw[arrow,draw=fusionorange] (f.south west) -- (9.8,-.75) -- (2.2,-.75) -- node[tag,left] {Build from $F$} (w.north);
\draw[arrow,draw=embeddingblue] (f.south) -- (10,-1.2) -- (7.1,-1.2) -- (refine.north);
\node[tag,text=embeddingblue] at (7.15,-1.02) {$F$: Fidelity anchor};
\draw[arrow,draw=fusionorange] (w) -- (refine);
\node[tag,text=fusionorange] at (4.45,-2.95) {$W$: Pairwise fusion weights};
\node[box,text width=1.8cm] (sck) at (11.2,-1.9) {K-means\\SC baseline};
\draw[arrow] (f.east) -- (12.55,0) -- (12.55,-1.9) -- (sck.east);
\node[box,text width=2.05cm] (sco) at (11.2,-3.05) {SC cluster\\assignments};
\draw[arrow] (sck) -- (sco);
\node[green,text width=2.4cm] (g) at (7.1,-3.65) {$G$\\Shrunk\\representation};
\node[green,text width=1.8cm] (ssck) at (3.9,-3.65) {K-means\\SSC};
\node[green,text width=1.85cm] (ssco) at (1.05,-3.65) {SSC cluster\\assignments};
\draw[arrow,draw=outputgreen] (refine) -- (g);
\draw[arrow,draw=outputgreen] (g) -- (ssck);
\draw[arrow,draw=outputgreen] (ssck) -- (ssco);
\node[align=center,inner sep=3pt,anchor=north] at (6.2,-4.4) {\textbf{SSC refinement objective (Equation 8)}\\[4pt]
$\textstyle\min_G\bigl[\underbrace{\sum_i\|g_i-f_i\|_2}_{\text{\color{embeddingblue}Fidelity to }F}
+\underbrace{2\gamma\sum_{i<j}W_{ij}\|g_i-g_j\|_2}_{\text{\color{fusionorange}Fusion controlled by }W}\bigr]$\\[4pt]
Each undirected edge once; both norms unsquared.};
\end{tikzpicture}
