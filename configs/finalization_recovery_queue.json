{
  "version": 1,
  "purpose": "Run separately after the completed final scientific export. Verify its dependency record and archive hashes before recovery, using the same shared ledger and aggregation reserve.",
  "frozen_before_execution": true,
  "requires_completed_queue": "configs/finalization_archive_queue.json",
  "tasks": [
    {
      "run_id": "finalization-scientific-recovery-v1",
      "kind": "archive",
      "phase": "aggregation",
      "operation": "recover",
      "cpu_limit": 1800,
      "wall_limit": 3615,
      "archive_name": "comp3314-scientific-artifacts-v1.tar.gz",
      "recovery_name": "comp3314-recovered-artifacts-v1",
      "depends_on": "finalization-scientific-export-v1"
    }
  ]
}
