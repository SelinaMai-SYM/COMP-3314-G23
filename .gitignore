# The gzip twin and SHA-256 are in results/v3_reproduction/.
results/v3_reproduction/all_trials.csv
# Publisher PDFs, recovered archives, and face matrices stay local.
**/resources/private/
# Current experiment arrays and temporary build artifacts remain local.
runs/next_round/
.rebuild-*/
